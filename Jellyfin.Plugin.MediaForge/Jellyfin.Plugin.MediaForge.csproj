<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <RootNamespace>Jellyfin.Plugin.MediaForge</RootNamespace>
    <AssemblyVersion>0.6.8.0</AssemblyVersion>
    <FileVersion>0.6.8.0</FileVersion>
    <Version>0.6.8.0</Version>
    <InformationalVersion>0.6.8</InformationalVersion>
    <Authors>MediaForge Jellyfin Connector contributors</Authors>
    <Product>MediaForge Requests</Product>
    <Description>Search MediaForge from Jellyfin and submit downloads through an approval workflow.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" />
  </ItemGroup>

</Project>



